import java.io.*;

public class RARPCombined
{
    public static void main(String args[]) throws Exception
    {
        BufferedReader in = new BufferedReader(new InputStreamReader(System.in));

        // MAC and IP table (same as server)
        String ip[] = {"10.0.3.186"};
        String mac[] = {"D4:3D:7E:12:A3:D9"};

        System.out.println("Enter the Physical Address: ");
        String inputMac = in.readLine();

        String logicalAddress = null;

        // Search for matching MAC
        for(int i = 0; i < mac.length; i++)
        {
            if(inputMac.equals(mac[i]))
            {
                logicalAddress = ip[i];
                break;
            }
        }

        if(logicalAddress != null)
        {
            System.out.println("The Logical Address is: " + logicalAddress);
        }
        else
        {
            System.out.println("No matching Logical Address found.");
        }
    }
}
